#!/bin/zsh
set -eu
umask 077
PATH=/usr/bin:/bin
export PATH
unset PYTHONPATH PYTHONHOME VIRTUAL_ENV CONDA_PREFIX BASH_ENV ENV 2>/dev/null || true

STATE="$HOME/AI/State/Tools/Dropbox Governed Execution Relay"
IDENTITY="$STATE/delivered-identity.json"
BINDING="$STATE/runtime-binding.json"
PYRUNWAY="/usr/local/bin/pyrunway"
[ -f "$IDENTITY" ] && [ ! -L "$IDENTITY" ] || { print -u2 DGER_DELIVERED_IDENTITY_UNAVAILABLE; exit 69; }
[ -f "$BINDING" ] && [ ! -L "$BINDING" ] || { print -u2 DGER_RUNTIME_BINDING_UNAVAILABLE; exit 69; }
[ -f "$PYRUNWAY" ] && [ ! -L "$PYRUNWAY" ] && [ -x "$PYRUNWAY" ] || { print -u2 PYRUNWAY_ENVIRONMENT_UNAVAILABLE; exit 69; }

RUNTIME_ROOT="$(/usr/bin/plutil -extract runtime_root raw -o - "$IDENTITY" 2>/dev/null || true)"
CANDIDATE_SHA="$(/usr/bin/plutil -extract candidate_sha raw -o - "$IDENTITY" 2>/dev/null || true)"
[ -n "$RUNTIME_ROOT" ] && [ -d "$RUNTIME_ROOT" ] && [ ! -L "$RUNTIME_ROOT" ] || { print -u2 DGER_RUNTIME_UNAVAILABLE; exit 69; }
print -r -- "$CANDIDATE_SHA" | /usr/bin/grep -Eq '^[0-9a-f]{40}$' || { print -u2 DGER_DELIVERED_IDENTITY_INVALID; exit 69; }
ENTRY="$RUNTIME_ROOT/scripts/dger.py"
[ -f "$ENTRY" ] && [ ! -L "$ENTRY" ] || { print -u2 DGER_RUNTIME_UNAVAILABLE; exit 69; }

MOH_HOME="$(/usr/bin/plutil -extract moh_home raw -o - "$BINDING" 2>/dev/null || true)"
GTG_ENDPOINT="$(/usr/bin/plutil -extract gtg_endpoint raw -o - "$BINDING" 2>/dev/null || true)"
GTG_TOKEN_FILE="$(/usr/bin/plutil -extract gtg_token_file raw -o - "$BINDING" 2>/dev/null || true)"
INSECURE_LOCAL="$(/usr/bin/plutil -extract allow_insecure_localhost_gtg raw -o - "$BINDING" 2>/dev/null || true)"
[ -n "$MOH_HOME" ] && [ -d "$MOH_HOME" ] && [ ! -L "$MOH_HOME" ] || { print -u2 DGER_MOH_BINDING_UNAVAILABLE; exit 69; }
[ -n "$GTG_ENDPOINT" ] || { print -u2 DGER_GTG_BINDING_UNAVAILABLE; exit 69; }
[ -n "$GTG_TOKEN_FILE" ] && [ -f "$GTG_TOKEN_FILE" ] && [ ! -L "$GTG_TOKEN_FILE" ] || { print -u2 DGER_GTG_BINDING_UNAVAILABLE; exit 69; }

DROPBOX_ROOT=""
DROPBOX_ROOT_COUNT=0
for BASE in "$HOME/Library/CloudStorage"/*; do
  [ -d "$BASE" ] || continue
  SOFTWARE="$BASE/Software"
  MARKER="$SOFTWARE/NSP - Temporary Files"
  if [ -d "$MARKER" ]; then
    DROPBOX_ROOT="$BASE"
    DROPBOX_ROOT_COUNT=$((DROPBOX_ROOT_COUNT + 1))
  fi
done
[ "$DROPBOX_ROOT_COUNT" -eq 1 ] || { print -u2 DGER_DROPBOX_ROOT_AMBIGUOUS_OR_MISSING; exit 69; }
TRANSPORT="$DROPBOX_ROOT/Software/Dropbox Governed Execution Relay/V2"
/bin/mkdir -p "$TRANSPORT"
[ -d "$TRANSPORT" ] && [ ! -L "$TRANSPORT" ] || { print -u2 DGER_TRANSPORT_UNAVAILABLE; exit 69; }

EXTRA=()
case "$INSECURE_LOCAL" in
  true|1) EXTRA+=(--allow-insecure-localhost-gtg) ;;
  false|0) ;;
  *) print -u2 DGER_GTG_BINDING_INVALID; exit 69 ;;
esac

exec "$PYRUNWAY" --standalone "$ENTRY" \
  --transport-root "$TRANSPORT" \
  --state-root "$STATE" \
  --moh-home "$MOH_HOME" \
  --gtg-endpoint "$GTG_ENDPOINT" \
  --gtg-token-file "$GTG_TOKEN_FILE" \
  "${EXTRA[@]}"
